{
  "name": "twinleaf-json",
  "version": "1.0.0",
  "scripts": {
    "pretty": "prettier . --write",
    "build": "tsx index.ts ./dist  --clean",
    "lint": "eslint **/*.ts",
    "lint:fix": "eslint \"**/*.ts\" --ignore-pattern node_modules/ --fix",
    "format:write": "prettier --write \"**/*.{ts,js}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,js}\" --cache"
  },
  "type": "module",
  "author": "",
  "license": "MIT",
  "description": "",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./dist/*"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.10",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.1",
    "prettier": "^3.3.3",
    "simple-git": "^3.27.0",
    "tsx": "^4.19.2",
    "twinleaf-json-common": "^1.0.0",
    "twinleaf-json-remote": "^1.0.0"
  }
}
